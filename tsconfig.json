{
  "compilerOptions": {
    "target": "ES2021",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "outDir": "./dist",
    "resolveJsonModule": true,
  },
  "include": ["api/*", "config/*", "coordinator/**/*", "worker/**/*", "shared/**/*", "tui/**/*", "scripts/**/*", "models/**/*"]
}


