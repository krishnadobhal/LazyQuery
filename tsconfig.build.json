{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "allowImportingTsExtensions": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "index.ts",
    "core/**/*",
    "coordinator/**/*",
    "worker/**/*",
    "shared/**/*",
    "tui/**/*",
    "api/**/*",
    "config/**/*"
  ]
}
